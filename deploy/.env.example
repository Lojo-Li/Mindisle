# ============================================
# 心屿 Mindisle 生产环境变量模板
# 复制为 .env 后按需修改，切勿把真实密钥提交到仓库
# ============================================

# ---------- 应用 ----------
APP_ENV=production
APP_DEBUG=False
SECRET_KEY=请替换为32位以上随机字符串

# ---------- 数据库 ----------
# 云上 MySQL（托管实例或同 compose 的 mysql 服务）
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名
DATABASE_URL=mysql+pymysql://mindisle:CHANGE_ME@mysql:3306/soulstation

# ---------- Redis ----------
# 没有 Redis 时置为 False，应用会退化为进程内缓存，功能不受影响
REDIS_ENABLED=False
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- 邮件（可选）----------
# 不配置则跳过邮件发送，不影响预约流程
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=smtp.163.com
MAIL_FROM_NAME=心屿心理支持

# ---------- AI 模型（可选）----------
# 不配置则「屿灯」AI 对话不可用，其余功能正常
# 支持供应商无关切换，按实际使用的供应商填写
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=

DOUBAO_APP_ID=
DOUBAO_ACCESS_TOKEN=
DOUBAO_SECRET_KEY=
DOUBAO_API_KEY=
