# 心屿 Mindisle 后端环境配置模板
# 用法：复制为 .env 后填入真实值。.env 不要提交到仓库。
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)

APP_NAME=Mindisle
APP_VERSION=1.0.0
APP_DEBUG=False

# ── 数据库 ────────────────────────────────────────────────
# 本地开发推荐 SQLite（无需安装数据库，开箱可用）：
DATABASE_URL=sqlite:///./soulstation.db
# 使用 MySQL 时改成（compose 里的端口是 3307）：
# DATABASE_URL=mysql+pymysql://root:你的密码@localhost:3307/soulstation

# ── JWT ──────────────────────────────────────────────────
# 生产环境务必换成一串随机值，不要用示例值
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ── 大模型（OpenAI 兼容接口）──────────────────────────────
# 换供应商只改这三行，代码不用动。
# DeepSeek 示例：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
#
# 火山方舟（豆包）示例：
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的方舟密钥
# LLM_MODEL=ep-2025xxxx-xxxxx   # 接入点 ID，不是模型名

# ── RAG 检索 ─────────────────────────────────────────────
# 向量库路径。Windows 上必须用纯英文路径：
#   hnswlib 打不开含中文的路径，症状是重启后报 "Cannot open header file"
CHROMA_DB_PATH=C:/mindisle_chroma
CHROMA_COLLECTION_NAME=psychology_kb
RAG_TOP_K=3
RAG_METRIC=cosine
# cosine 下含义为“最低相似度”，0.45 约等于“沾边但不算跑题”
RAG_MIN_SIMILARITY=0.45

# ── Redis ────────────────────────────────────────────────
# 本地没有 Redis 时关掉，不影响主流程
REDIS_ENABLED=False
REDIS_URL=redis://localhost:6379/0

# ── 邮件（找回密码用，可选）───────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=smtp.163.com
MAIL_TLS=False
MAIL_SSL=True
MAIL_FROM_NAME=心屿

# ── 其他 ─────────────────────────────────────────────────
UPLOAD_DIR=./app/static/uploads
MAX_UPLOAD_SIZE=10485760
FRONTEND_URL=http://localhost:5173
PUBLIC_URL=http://localhost:8000
AI_ASSISTANT_NAME=屿灯
AI_VERIFY_SSL=True
